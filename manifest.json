{
  "manifest_version": 3,
  "name": "Facebook Group Scraper",
  "version": "1.0.0",
  "description": "Scrape Facebook group posts",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/groups/*",
        "https://*.facebook.com/permalink.php*",
        "https://*.facebook.com/*/posts/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://*.facebook.com/*"]
    }
  ]
}